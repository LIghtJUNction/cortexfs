[Unit]
Description=CortexFS Mattermost channel adapter
Documentation=file:/usr/share/doc/cortexfs/docs/channels.md
After=network-online.target cortexfs.service
Wants=network-online.target
Requires=cortexfs.service
PartOf=cortexfs.service

[Service]
Type=simple
EnvironmentFile=/etc/cortexfs/channels/mattermost.env
ExecStart=/usr/bin/cortexfs-channel mattermost
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=128M
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/cortexfs/channels
UMask=0077

[Install]
WantedBy=multi-user.target
