[Unit]
Description=CortexFS agent runtime for %i
Documentation=file:/usr/share/doc/cortexfs/README.md
BindsTo=cortexfs.service
PartOf=cortexfs.service
After=cortexfs.service
After=cortexfs-terminal-broker.socket
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/cortexfs/*.env
ExecStart=/usr/bin/cortexfs-agent-runtime --source /var/lib/cortexfs/storage/current --agent %i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=512M
MemoryHigh=384M
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024
OOMPolicy=stop
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
ReadWritePaths=/var/lib/cortexfs /run/cortexfs
ReadOnlyPaths=/etc/cortexfs
UMask=0077
