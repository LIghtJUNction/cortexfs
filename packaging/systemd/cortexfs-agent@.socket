[Unit]
Description=CortexFS agent socket for %i
Documentation=file:/usr/share/doc/cortexfs-git/README.md
Requires=cortexfs.service
After=cortexfs.service

[Socket]
ListenStream=/run/cortexfs/agent/%i.sock
SocketMode=0666
RemoveOnStop=yes
ExecStartPre=/usr/bin/install -d -m 0755 /run/cortexfs/agent
ExecStartPre=/usr/bin/rm -f /run/cortexfs/agent/%i.sock /var/lib/cortexfs/storage/v1-root/agent/%i.sock
ExecStartPre=/usr/bin/ln -s /run/cortexfs/agent/%i.sock /var/lib/cortexfs/storage/v1-root/agent/%i.sock

[Install]
WantedBy=sockets.target
