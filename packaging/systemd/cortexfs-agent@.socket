[Unit]
Description=CortexFS agent socket for %i
Documentation=file:/usr/share/doc/cortexfs/README.md
DefaultDependencies=no
Requires=cortexfs.service
After=cortexfs.service
Conflicts=shutdown.target
Before=shutdown.target

[Socket]
ListenStream=/run/cortexfs/agent/%i.sock
SocketMode=0666
RemoveOnStop=yes
ExecStartPre=/usr/bin/install -d -m 0755 /run/cortexfs/agent
ExecStartPre=/usr/bin/cortexfs-agent-runtime --prepare-socket-alias --source /var/lib/cortexfs/storage/current --agent %i
ExecStopPost=/usr/bin/cortexfs-agent-runtime --cleanup-socket-alias --source /var/lib/cortexfs/storage/current --agent %i

[Install]
WantedBy=sockets.target
