[Unit]
Description=CortexFS FUSE mount at /ctx for %i
Documentation=https://lightjunction.github.io/cortexfs/docs/getting-started/install-deploy/
After=local-fs.target

[Service]
Type=simple
User=%i
Group=%i
ExecStartPre=+/usr/bin/cortex mount-prep /ctx %i %i
ExecStart=/usr/bin/cortex mount /ctx
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
