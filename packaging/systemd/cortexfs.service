[Unit]
Description=CortexFS FUSE mount
Documentation=file:/usr/share/doc/cortexfs/README.md
After=local-fs.target

[Service]
Type=simple
StateDirectory=cortexfs
StateDirectoryMode=0755
EnvironmentFile=-/etc/cortexfs/*.env
ExecStartPre=/usr/bin/sh -c 'if /usr/bin/findmnt -n /ctx >/dev/null 2>&1; then /usr/bin/umount -l /ctx; fi'
ExecStartPre=/usr/bin/install -d -m 0755 /ctx
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/cortexfs /var/lib/cortexfs/storage /var/lib/cortexfs/storage/generations
ExecStartPre=/usr/bin/ctx storage update --prune /var/lib/cortexfs/storage
ExecStart=/usr/bin/cortexfs-mount --source /var/lib/cortexfs/storage/current /ctx
ExecStop=/usr/bin/umount -l /ctx
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
