[Unit]
Description=CortexFS terminal authorization broker
Documentation=file:/usr/share/doc/cortexfs/docs/spec/terminal-broker.md
Requires=cortexfs-terminal-broker.socket
After=cortexfs-terminal-broker.socket

[Service]
Type=simple
ExecStart=/usr/bin/cortexfs-terminal-broker
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=80
LimitNOFILE=1024
