#!/bin/sh
set -e

[ "${CORTEXFS_UPDATE_TRANSACTION:-0}" = 1 ] && exit 0

if [ "$1" = configure ]; then
    /usr/bin/install -d -m 0755 \
        /etc/cortexfs/providers.d \
        /var/lib/cortexfs/storage/generations
    /usr/bin/install -d -m 0700 /var/lib/cortexfs/secrets
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper enable cortexfs.service >/dev/null || true
            deb-systemd-helper enable cortexfs-terminal-broker.socket >/dev/null || true
        else
            systemctl enable cortexfs.service cortexfs-terminal-broker.socket >/dev/null 2>&1 || true
        fi
        systemctl start cortexfs-terminal-broker.socket >/dev/null 2>&1 || true
        if [ -n "${2:-}" ]; then
            systemctl try-restart cortexfs-terminal-broker.service >/dev/null 2>&1 || true
            if systemctl is-active --quiet cortexfs.service; then
                systemctl try-restart cortexfs.service >/dev/null 2>&1 || true
                for socket_path in /etc/systemd/system/sockets.target.wants/cortexfs-agent@*.socket; do
                    [ -e "$socket_path" ] || continue
                    socket=$(basename "$socket_path")
                    systemctl start "$socket" >/dev/null 2>&1 || true
                done
            fi
        fi
    fi
fi

exit 0
