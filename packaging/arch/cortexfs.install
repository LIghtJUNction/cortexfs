post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable cortexfs.service >/dev/null 2>&1 || true
}

post_upgrade() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    if systemctl is-active --quiet cortexfs.service; then
        systemctl try-restart cortexfs.service >/dev/null 2>&1 || true
        for socket_path in /etc/systemd/system/sockets.target.wants/cortexfs-agent@*.socket; do
            [[ -e $socket_path ]] || continue
            socket=${socket_path##*/}
            systemctl start "$socket" >/dev/null 2>&1 || true
        done
    fi
}

pre_remove() {
    if [[ ${1:-} == remove ]]; then
        systemctl disable --now cortexfs.service >/dev/null 2>&1 || true
    fi
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
}
