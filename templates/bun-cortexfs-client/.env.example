CORTEXFS_MOUNT=/ctx
CORTEXFS_UID=1000
CORTEXFS_FORMAT=openai.chat
CORTEXFS_TRANSPORT=file
CORTEXFS_REQUEST_ID=
CORTEXFS_PROMPT=Reply with exactly: cortexfs-ok

# Optional. If unset, the template reads CTX_HOME/api/http/listen and builds
# http://<listen>/v1, falling back to http://127.0.0.1:6185/v1.
CORTEXFS_BASE_URL=

# Optional. CortexFS local API should resolve real provider secrets itself.
CORTEXFS_API_KEY=
